{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangSmith access_policies API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "access_policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List access policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/platform/orgs/current/access-policies",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all access policies for the organization."
        },
        {
          "info": {
            "name": "Create an access policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/platform/orgs/current/access-policies",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new access policy."
        },
        {
          "info": {
            "name": "Attach access policies to a role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/platform/orgs/current/access-policies/roles/:role_id/access-policies",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "Role ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Attaches one or more access policies to a specific role. The request body must contain an array of access policy IDs."
        },
        {
          "info": {
            "name": "Get an access policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/platform/orgs/current/access-policies/:access_policy_id",
            "params": [
              {
                "name": "access_policy_id",
                "value": "",
                "type": "path",
                "description": "Access Policy ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Gets a specific access policy by ID."
        },
        {
          "info": {
            "name": "Delete an access policy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/platform/orgs/current/access-policies/:access_policy_id",
            "params": [
              {
                "name": "access_policy_id",
                "value": "",
                "type": "path",
                "description": "Access Policy ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a specific access policy by ID."
        }
      ]
    }
  ],
  "bundled": true
}
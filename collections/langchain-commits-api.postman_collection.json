        {
          "id": "ab1224b7-3d09-4115-bcd7-77785ba48b92",
          "name": "Get a commit",
          "request": {
            "name": "Get a commit",
            "description": {
              "content": "Retrieves a specific commit by hash, tag, or \"latest\" for a repository.\nThis endpoint supports both authenticated and unauthenticated access.\nAuthenticated users can access private repos, while unauthenticated users can only access public repos.\nCommit resolution logic:\n- \"latest\" or empty: Get the most recent commit\n- Less than 8 characters: Only check for tags\n- 8 or more characters: Prioritize commit hash over tag, check both",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "commits",
                ":owner",
                ":repo",
                ":commit"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "get_examples",

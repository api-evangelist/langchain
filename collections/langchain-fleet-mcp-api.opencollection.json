{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangSmith access_policies fleet mcp API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "fleet mcp",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List MCP tools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/fleet/mcp/tools",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query",
                "description": "MCP server URL to fetch tools from"
              },
              {
                "name": "oauth_provider_id",
                "value": "",
                "type": "query",
                "description": "OAuth provider ID for token-based auth"
              },
              {
                "name": "force_refresh",
                "value": "",
                "type": "query",
                "description": "Skip cache and fetch fresh tools"
              },
              {
                "name": "ls_user_id",
                "value": "",
                "type": "query",
                "description": "User ID override (service-key callers)"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns tools from a remote MCP server. Serves cached results when fresh, otherwise fetches from the remote server and caches the response."
        },
        {
          "info": {
            "name": "List MCP servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/platform/fleet/mcp-servers",
            "headers": [
              {
                "name": "X-Ls-User-Id",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns MCP servers visible to the caller after ABAC filtering. Service-key callers may pass X-Ls-User-Id to resolve per-user OAuth providers."
        },
        {
          "info": {
            "name": "Create MCP server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/platform/fleet/mcp-servers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Registers a new MCP server configuration for the workspace."
        },
        {
          "info": {
            "name": "Get MCP server",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/platform/fleet/mcp-servers/:mcp_server_id",
            "params": [
              {
                "name": "mcp_server_id",
                "value": "",
                "type": "path",
                "description": "MCP server ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a single MCP server by ID."
        },
        {
          "info": {
            "name": "Update MCP server",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/v1/platform/fleet/mcp-servers/:mcp_server_id",
            "params": [
              {
                "name": "mcp_server_id",
                "value": "",
                "type": "path",
                "description": "MCP server ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Partially updates an MCP server. Tool list cache is invalidated on success."
        },
        {
          "info": {
            "name": "Delete MCP server",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/platform/fleet/mcp-servers/:mcp_server_id",
            "params": [
              {
                "name": "mcp_server_id",
                "value": "",
                "type": "path",
                "description": "MCP server ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes an MCP server configuration."
        },
        {
          "info": {
            "name": "Register per-user MCP OAuth provider",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/platform/fleet/mcp-servers/:mcp_server_id/oauth-provider",
            "params": [
              {
                "name": "mcp_server_id",
                "value": "",
                "type": "path",
                "description": "MCP server ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Discovers and registers an OAuth provider for a user against an MCP server configured with per-user dynamic client mode. Idempotent when a mapping already exists."
        }
      ]
    }
  ],
  "bundled": true
}
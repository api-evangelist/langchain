              "placement": "header"
            }
          },
          "docs": "Returns the top tools in the workspace with run counts, latency, and agent counts for the given time window. Defaults to sorting by runs descending; pass sort_by and sort_order to change."
        },
        {
          "info": {
            "name": "List fleet users with usage",

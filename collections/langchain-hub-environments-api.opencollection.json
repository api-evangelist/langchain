        },
        {
          "info": {
            "name": "Delete hub environments model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v1/hub/environments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes the hub environments configuration. Tenant reverts to defaults."

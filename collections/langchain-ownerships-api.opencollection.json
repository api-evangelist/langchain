{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangSmith access_policies ownerships API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "ownerships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Repo Owners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/repos/:owner/:repo/owners",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List all owners of a repo.\n\nRequires read permission on the repo."
        },
        {
          "info": {
            "name": "Add Repo Owner",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v1/repos/:owner/:repo/owners",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Add an owner to a repo.\n\nRequires being an existing owner of the repo."
        },
        {
          "info": {
            "name": "Remove Repo Owner",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v1/repos/:owner/:repo/owners",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Remove an owner from a repo.\n\nRequires being an existing owner of the repo."
        }
      ]
    }
  ],
  "bundled": true
}
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a tag. Requires repo ownership, prompts:tag permission, or ABAC grant."

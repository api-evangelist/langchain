          "info": {
            "name": "Get Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/repos/:owner/:repo/tags",
            "params": [
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get Tags"
        },
        {
          "info": {
            "name": "Create Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
